---
import Base from '../layouts/Base.astro';
import StampBoard from '../components/StampBoard.astro';
import { SITE, url } from '../lib/site';
import '../styles/again.css';
---
<Base title={`다시 만나기 — ${SITE.name}`} description="전에 본 표현, 지금 떠오르시나요?" nav="again">
  <div class="wrap reading" data-review-v2="true" data-catalog-url={url('/expressions.json')}>
    <header class="again-head">
      <div class="hero-eyebrow">까먹당 · 다시 만나기</div>
      <h1>오늘의 약속</h1>
      <p id="againLead">불러오는 중…</p>
    </header>

    <div id="qLive" class="sr-only" aria-live="polite"></div>

    <div class="slot">
      <article class="quizcard" id="card" hidden aria-labelledby="qAsk">
        <div class="q-top">
          <span class="q-scene">
            <span id="qEmoji" aria-hidden="true"></span>
            <span id="qStage"></span>
          </span>
          <span class="q-progress" id="qProgress" aria-label="오늘 복습 진행"></span>
        </div>

        <figure class="q-memory" id="qMemory" hidden>
          <img id="qMemoryImage" class="q-memory-image" alt="" hidden />
          <figcaption id="qMemoryText" class="q-memory-text"></figcaption>
        </figure>

        <div class="q-scene-card" id="qScene" hidden>
          <strong id="qSceneWho"></strong>
          <span id="qSceneKr"></span>
        </div>

        <h2 class="q-ask" id="qAsk" tabindex="-1"></h2>
        <div class="q-cloze jp" id="qCloze" lang="ja" hidden></div>
        <p class="q-prompt" id="qPrompt">일본어로 뭐라고 했더라?</p>
        <button class="q-reveal" id="qReveal" type="button">정답 보기</button>

        <div class="q-answer" id="qAnswer" tabindex="-1" hidden>
          <div class="q-scene-answer jp" id="qSceneAnswer" lang="ja" hidden></div>
          <div class="q-ans-jp jp" id="qAnsJp" lang="ja"></div>
          <div class="q-ans-expr">
            <span class="jp" id="qAnsExpr" lang="ja"></span>
            <span class="q-ans-kr" id="qAnsKr"></span>
          </div>
          <p class="q-explanation" id="qExplanation" hidden></p>
        </div>

        <div class="q-grade" id="qGrade" aria-label="기억 상태 선택" hidden>
          <button class="g-btn ok" type="button" data-rating="remembered">
            <span class="g-emoji" aria-hidden="true">💡</span>
            <span class="g-label">기억나요</span>
          </button>
          <button class="g-btn vague" type="button" data-rating="fuzzy">
            <span class="g-emoji" aria-hidden="true">🌫️</span>
            <span class="g-label">가물가물</span>
          </button>
          <button class="g-btn lost" type="button" data-rating="unfamiliar">
            <span class="g-emoji" aria-hidden="true">🌱</span>
            <span class="g-label">낯설어요</span>
          </button>
        </div>

        <p class="q-feedback" id="qFeedback" aria-live="polite" hidden></p>
        <button class="q-next" id="qNext" type="button" hidden>다음 표현</button>
      </article>

      <section class="restcard" id="rest" hidden aria-labelledby="restText">
        <div class="rest-emoji"><img src={url('/cha-rest-2.webp')} alt="" width="90" height="90" /></div>
        <h2 class="rest-text" id="restText" tabindex="-1"></h2>
        <button class="pill" id="restMore" type="button" hidden>조금 더 만나볼까요?</button>
      </section>
    </div>

    <div id="bottom" class="again-bottom">
      <div class="counters" id="learningSummary" aria-label="학습 기록" tabindex="-1">
        <div class="counter">
          <span class="c-num" id="cReunions">0</span>
          <span class="c-label">다시 만남</span>
        </div>
        <div class="counter">
          <span class="c-num" id="cGraduated">0</span>
          <span class="c-label">졸업</span>
        </div>
      </div>

      <section class="reactivation" id="reactivation" aria-labelledby="reactivationTitle" hidden>
        <h2 id="reactivationTitle">잠시 쉬는 표현</h2>
        <p>다시 만나기를 누르면 잠시 쉬기를 마치고, 이틀 뒤 다시 만나요.</p>
        <div class="reactivation-list" id="reactivationList"></div>
      </section>

      <StampBoard season={1} />

      <a class="review-link" id="reviewLink" href={url('/review/s1/')} hidden>
        시즌 1 총복습호 · 18개를 한 번에 →
      </a>

      <p class="storage-note">
        ※ 까먹당과 함께한 기록은 이 브라우저에 저장돼요. 기기를 바꾸거나 브라우저 데이터를 삭제하면 기록이 사라져요.
      </p>

      <nav class="again-links" aria-label="다시 만나기 관련 메뉴">
        <a class="pill" href={url('/again/cards/')}>골라 풀기</a>
        <a class="pill" href={url('/again/archive/')}>추억 보관함</a>
      </nav>
    </div>
  </div>

  <script>
    import { initReviewFlowPage } from '../lib/client/review-flow';
    initReviewFlowPage();
  </script>
</Base>
