---
/**
 * 다시 만나기 (1층)
 * -------------------------------------------------------------
 * 개발지시서 §4-3 · §4-4 · §7-3
 *
 * 상단 슬롯에는 상태에 따라 **하나만** 그립니다.
 *   만기 있음         → 퀴즈 카드
 *   오늘 완료 + 남음  → "오늘 몫은 여기까지" + 더 보기 (날짜 없음)
 *   큐 비었음         → "오늘은 까먹은 게 없네요" + 다음 예정일
 *
 * 밀린 개수·실패 횟수·진행률은 어디에도 표시하지 않습니다.
 */
import Base from '../layouts/Base.astro';
import StampBoard from '../components/StampBoard.astro';
import { SITE, url } from '../lib/site';
import '../styles/again.css';
---
<Base title={`다시 만나기 — ${SITE.name}`} description="사흘 전에 본 표현, 지금 떠오르시나요?" nav="again">
  <div class="wrap reading">
    <div class="again-head">
      <div class="hero-eyebrow">까먹당 · 다시 만나기</div>
      <h1 id="againTitle">오늘의 약속</h1>
      
      <p id="againLead">불러오는 중…</p>
    </div>

    {/* ---------- 상단 슬롯 ---------- */}
    <div id="slot" class="slot">
      {/* 퀴즈 카드 */}
      <article class="quizcard" id="card" hidden>
        <div class="q-top">
          <span class="q-scene"><span id="qEmoji"></span> 지난번에 만난 표현이에요</span>
          <span class="q-progress" id="qProgress"></span>
        </div>

        <div class="q-ask" id="qAsk"></div>
        <div class="q-prompt" id="qPrompt">일본어로 뭐라고 했더라?</div>

        <button class="q-reveal" id="qReveal" type="button">정답 보기</button>

        {/* 정답은 크게 하나만. 설명은 접힌 영역이 아니라 그 편에서 보게 합니다. */}
        <div class="q-answer" id="qAnswer" hidden>
          <div class="q-ans-jp jp" id="qAnsJp"></div>
          <div class="q-ans-expr">
            <span class="jp" id="qAnsExpr"></span>
            <span class="q-ans-kr" id="qAnsKr"></span>
          </div>
        </div>

        {/* 정답을 본 뒤에만 나타납니다 */}
        {/* 누른 결과를 한 줄로 알려준 뒤 다음으로 넘어갑니다 */}
        <div class="q-feedback" id="qFeedback" hidden></div>

        <div class="q-grade" id="qGrade" hidden>
          <button class="g-btn ok" data-r="ok" type="button">
            <span class="g-emoji">😎</span><span class="g-label">기억나요</span>
          </button>
          <button class="g-btn vague" data-r="vague" type="button">
            <span class="g-emoji">🤔</span><span class="g-label">가물가물</span>
          </button>
          <button class="g-btn lost" data-r="lost" type="button">
            <span class="g-emoji">🫠</span><span class="g-label">낯설어요</span>
          </button>
        </div>
      </article>

      {/* 메일 버튼으로 들어왔을 때 (§6-3) */}
      <article class="arrive" id="arrive" hidden>
        <div class="ar-emoji" id="arEmoji"></div>
        <h2 class="ar-title" id="arTitle"></h2>
        <div class="ar-jp jp" id="arJp"></div>

        {/* 졸업했을 때만 나옵니다 */}
        <div class="ar-grad" id="arGrad" hidden>
          <span class="ar-grad-badge">졸업</span>
          <span class="ar-grad-text">세 번 연속 기억하셨어요. 이제 안 물어볼게요.</span>
        </div>

        <div class="ar-next" id="arNext"></div>
        <p class="ar-note" id="arNote" hidden></p>

        <div class="ar-btns">
          <a class="pill" id="arEp" href="#">이 편 다시 보기</a>
          <button class="pill primary" id="arGo" type="button">오늘의 약속 보기</button>
        </div>
      </article>



      {/* 오늘 몫 완료 · 큐 비었음 */}
      <div class="restcard" id="rest" hidden>
        <div class="rest-emoji" id="restEmoji"><img src="/cha-rest-1.webp" alt="" /></div>
        <div class="rest-text" id="restText"></div>
        <button class="pill" id="restMore" type="button" hidden>조금 더 만나볼까요?</button>
      </div>
    </div>

    {/* ---------- 하단 ----------
        카운터와 도장판은 세 상태 모두에서 그대로 보입니다.
        골라 풀기·추억 보관함 버튼만 퀴즈 카드가 떠 있는 동안 숨겨요.
        (한 화면에 누를 것은 한 그룹만) */}
    <div id="bottom" class="again-bottom">
      <div class="counters">
        <div class="counter">
          <span class="c-num" id="cReunions">0</span>
          <span class="c-label">다시 만남</span>
        </div>
        <div class="counter">
          <span class="c-num" id="cGraduated">0</span>
          <span class="c-label">졸업</span>
        </div>
      </div>

      <StampBoard season={1} />

      {/* 시즌 회차를 다 읽었을 때만 나타납니다.
          평소에는 7주차 뉴스레터가 안내하고, 여기는 놓친 사람을 위한 길이에요. */}
      <a class="review-link" id="reviewLink" href={url('/review/s1/')} hidden>
        시즌 1 총복습호 · 18개를 한 번에 →
      </a>

      {/* 로그인이 없는 구조라 한 번은 알려둡니다 */}
      <p class="storage-note">
        ※ 까먹당과 함께한 기록은 이 브라우저에 저장돼요. 기기를 바꾸거나 브라우저 데이터를 삭제하면 기록이 사라져요.
      </p>

      <div class="again-links" id="againLinks">
        <a class="pill" href={url('/again/cards/')}>골라 풀기</a>
        <a class="pill" href={url('/again/archive/')}>추억 보관함</a>
      </div>
    </div>
  </div>


  <script is:inline define:vars={{ SRC: url('/expressions.json'), EP: url('/ep/') }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var byId = {};      // 표현 사전
      var queue = [];     // 오늘 꺼낼 것 (최대 3개)
      var pos = 0;
      var revealed = false;

      /* ---------- 준비 ---------- */
      fetch(SRC)
        .then(function (r) { return r.json(); })
        .then(function (list) {
          list.forEach(function (e) { byId[e.id] = e; });
          paintBottom();
          // 메일에서 왔으면 도착 화면을 먼저 띄웁니다
          if (!arrive()) build();
        })
        .catch(function () {
          $('againLead').textContent = '표현을 불러오지 못했어요.';
        });

        /* ---------- 메일 버튼 도착 (§6-3) ----------
         /again/?e={표현ID}&r=ok|no

         · 링크에 닿는 것만으로는 기록하지 않습니다.
           일부 메일 앱과 보안 검사기가 링크를 미리 열어보기 때문에,
           화면을 그린 뒤에 기록합니다.
         · 같은 날 두 번 눌러도 한 번만 반영됩니다 (lastSeen).
         · 이 기기에 기록이 없으면 그 표현만 새로 넣고 시작합니다.        */
      function arrive() {
        var q = new URLSearchParams(location.search);
        var id = q.get('e');
        var r = q.get('r');
        if (!id || !byId[id] || (r !== 'ok' && r !== 'no')) return false;

        var e = byId[id];
        var before = Kkmd.getExpr(id);
        var isNew = !before;
        var already = before && before.lastSeen === Kkmd.today();

        $('card').hidden = true;
        $('rest').hidden = true;
        $('arrive').hidden = false;
        $('againTitle').textContent = '다시 만날 약속';
        $('againLead').textContent = '';
        $('againLinks').hidden = true;

        $('arJp').innerHTML = e.jp;
        $('arEp').href = EP + e.slug + '/';

        // 화면을 그린 뒤에 기록합니다
        requestAnimationFrame(function () {
          var res = already ? before : record(id, r);
          paintArrive(r, res, { isNew: isNew, already: already });
          paintBottom();
          // 새로고침해도 다시 기록되지 않게 주소에서 값을 지웁니다
          if (history.replaceState) {
            history.replaceState(null, '', location.pathname);
          }
        });
        return true;
      }

      /** 메일에서 온 응답을 반영합니다. ok 는 14일, no 는 내일. */
      function record(id, r) {
        var e = Kkmd.getExpr(id);
        if (!e) {
          e = { state: 'new', streak: 0, nextDue: Kkmd.today(), lastSeen: null, graduated: false };
        }
        var was = e.state;
        if (r === 'ok') {
          e.state = 'ok';
          e.streak = (e.streak || 0) + 1;
          e.nextDue = Kkmd.plusDays(14);
          if (was === 'lost') Kkmd.bumpCounter('reunions', 1);
        } else {
          // 정답을 본 뒤에 누르는 것이라 회상을 시도한 결과입니다.
          // 그래서 🫠 낯설어요와 같은 처리 — 2일 뒤.
          // (에피소드의 「자신 없어요」는 시도 전에 누르는 것이라 내일로 당깁니다)
          e.state = 'lost';
          e.streak = 0;
          e.nextDue = Kkmd.plusDays(2);
        }
        e.lastSeen = Kkmd.today();
        if (e.streak >= 3 && !e.graduated) {
          e.graduated = true;
          Kkmd.bumpCounter('graduated', 1);
        }
        Kkmd.setExpr(id, e);
        return e;
      }

      function paintArrive(r, e, opt) {
        var grad = e.graduated;

        $('arEmoji').textContent = grad ? '🎓' : (r === 'ok' ? '😎' : '🫠');
        $('arTitle').textContent = grad
          ? '다 외우셨네요'
          : (r === 'ok' ? '기억하셨네요' : '괜찮아요, 또 가져올게요');

        $('arGrad').hidden = !grad;
        $('arNext').textContent = grad ? '' : fmtNext(e.nextDue);

        var note = opt.isNew ? '이 기기에는 아직 함께한 기록이 없어요. 지금부터 하나씩 쌓아가요.' : '';
        $('arNote').textContent = note;
        $('arNote').hidden = !note;
      }

      /** 다음 만남을 날짜가 아니라 사람 말로 알려줍니다. */
      function fmtNext(ymd) {
        var t = Kkmd.today();
        if (ymd <= t) return '오늘 다시 만나요';
        if (ymd === Kkmd.plusDays(1)) return '내일 다시 만나요';
        if (ymd === Kkmd.plusDays(2)) return '모레 다시 만나요';
        return '이 표현은 ' + fmt(ymd) + '에 다시 만나요';
      }

      /**
       * 오늘의 후보를 고릅니다. (§4-4)
       *   만기 도래 + 졸업 안 함
       *   낯설어요 우선 → 연체 오래된 순 → 회차 순
       *   😎 는 자리가 남을 때만
       */
      function candidates() {
        var today = Kkmd.today();
        var all = Kkmd.allExpr().filter(function (e) {
          return !e.data.graduated
            && byId[e.id]
            && Kkmd.onOrBefore(e.data.nextDue, today);
        });

        var rank = { lost: 0, vague: 1, new: 1, ok: 2 };
        all.sort(function (a, b) {
          var ra = rank[a.data.state] == null ? 1 : rank[a.data.state];
          var rb = rank[b.data.state] == null ? 1 : rank[b.data.state];
          if (ra !== rb) return ra - rb;
          if (a.data.nextDue !== b.data.nextDue) {
            return a.data.nextDue < b.data.nextDue ? -1 : 1;   // 오래 밀린 것부터
          }
          return byId[a.id].no - byId[b.id].no;
        });
        return all.map(function (e) { return e.id; });
      }

      /** 아직 안 본 후보 중 앞에서 3개 */
      var doneToday = [];
      function build() {
        var rest = candidates().filter(function (id) {
          return doneToday.indexOf(id) < 0;
        });
        queue = rest.slice(0, 3);
        pos = 0;
        render();
      }

      /* ---------- 그리기 ---------- */
      function render() {
        var hasCard = pos < queue.length;
        $('card').hidden = !hasCard;
        $('rest').hidden = hasCard;
        // 카운터·도장판은 그대로 두고, 누를 수 있는 링크만 감춥니다.
        $('againLinks').hidden = hasCard;

        // 총복습호도 같은 규칙 — 퀴즈 중에는 다른 화면으로 가는 길을 감춥니다.
        // 자격(도장 6개)은 paintBottom 이 dataset.eligible 에 적어둡니다.
        var rl = $('reviewLink');
        if (rl) rl.hidden = hasCard || !rl.dataset.eligible;

        if (hasCard) { showQuestion(byId[queue[pos]]); return; }
        showRest();
      }

      function showQuestion(e) {
        revealed = false;
        $('qReveal').hidden = false;
        $('qPrompt').hidden = false;
        $('qAnswer').hidden = true;
        $('qGrade').hidden = true;
        $('qFeedback').hidden = true;

        $('againTitle').textContent = '오늘의 약속';
        $('againLead').textContent = '떠오르지 않아도 괜찮아요. 기억은 이렇게 다시 만들어지는 거니까요.';

        $('qEmoji').textContent = e.emoji || '📮';
        $('qAsk').textContent = e.ask;
        // 물어본 것이 문장이니 답도 문장입니다. 표현은 그 아래 작게.
        $('qAnsJp').innerHTML = e.sentence || e.jp;
        $('qAnsExpr').innerHTML = e.jp;
        $('qAnsKr').textContent = e.kr;
        // 오늘 몫 안에서의 위치입니다. 밀린 개수와는 무관해요.
        $('qProgress').textContent = (pos + 1) + ' / ' + queue.length;
      }

      function showRest() {
        var left = candidates().filter(function (id) { return doneToday.indexOf(id) < 0; });

        $('againTitle').textContent = '오늘의 약속';

        if (doneToday.length > 0 && left.length > 0) {
          // 오늘 몫은 끝났지만 더 볼 수 있습니다. 날짜는 보여주지 않아요.
          $('againLead').textContent = '';
          $('restEmoji').innerHTML = '<img src="/cha-rest-3.webp" alt="">';
          $('restText').innerHTML =
            '오늘 몫은 여기까지예요' +
            '<span class="rest-sub">다시 만난 표현 ' + doneToday.length + '개</span>';
          $('restMore').hidden = false;
          return;
        }

        $('restMore').hidden = true;

        if (left.length === 0 && doneToday.length > 0) {
          $('againLead').textContent = '';
          $('restEmoji').innerHTML = '<img src="/cha-rest-2.webp" alt="">';
          $('restText').innerHTML =
            '오늘 만날 표현을 다 봤어요' +
            '<span class="rest-sub">다시 만난 표현 ' + doneToday.length + '개</span>';
          return;
        }

        // 큐가 비었을 때만 다음 예정일을 알려줍니다.
        var next = null;
        Kkmd.allExpr().forEach(function (e) {
          if (e.data.graduated) return;
          if (!next || e.data.nextDue < next) next = e.data.nextDue;
        });

        $('againLead').textContent = '';
        if (!next) {
          $('restEmoji').innerHTML = '<img src="/cha-rest-1.webp" alt="">';
          $('restText').innerHTML =
            '아직 만난 표현이 없어요' +
            '<span class="rest-sub dim">에피소드를 읽으면 그 편의 표현이 여기로 들어와요</span>';
        } else {
           $('restEmoji').innerHTML = '<img src="/cha-rest-2.webp" alt="">';
          $('restText').innerHTML =
            '오늘은 까먹은 게 없네요' +
            '<span class="rest-sub">다음 약속은 ' + fmt(next) + '이에요</span>' +
            '<span class="rest-sub dim">에피소드를 읽으면 그 편의 표현이 여기로 들어와요</span>';
        }
      }

      function fmt(ymd) {
        var p = String(ymd).split('-');
        return Number(p[1]) + '월 ' + Number(p[2]) + '일';
      }

      function paintBottom() {
        var c = Kkmd.getCounter();
        $('cReunions').textContent = c.reunions || 0;
        $('cGraduated').textContent = c.graduated || 0;

        var s = Kkmd.getStamps(1);
        document.querySelectorAll('.stamp-cell[data-no]').forEach(function (cell) {
          cell.classList.toggle('on', s.episodes.indexOf(Number(cell.dataset.no)) >= 0);
        });
        var fin = document.querySelector('.stamp-cell[data-final]');
        if (fin) fin.classList.toggle('on', !!s.completed);

        // 시즌 회차를 다 읽었거나 이미 완주했으면 총복습호로 가는 길을 엽니다
        var link = $('reviewLink');
        if (link) {
          // 에피소드를 다 읽었을 때만 길이 열립니다.
          // 완주 여부로 판단하지 않아요 — 어긋난 옛 기록이 남아 있을 수 있어서요.
          var ok = (s.episodes || []).length >= 6;
          link.dataset.eligible = ok ? '1' : '';
          link.hidden = !ok;
        }

        var prog = document.querySelector('[data-progress]');
        if (prog) {
          prog.textContent = (s.episodes.length + (s.completed ? 1 : 0)) + ' / 7';
        }
      }

      /* ---------- 응답 처리 (§4-3) ---------- */
      $('qReveal').addEventListener('click', function () {
        revealed = true;
        $('qReveal').hidden = true;
        $('qPrompt').hidden = true;   // 답을 봤으니 더 필요 없어요
        $('qAnswer').hidden = false;
        $('qGrade').hidden = false;
      });

      var FEEDBACK = {
        ok:    '오! 아직 안 까먹었네요 👏',
        vague: '이럴 때가 있죠. 한 번 더 만나봐요',
        lost:  '괜찮아요. 다시 만나면 되니까요',
      };

      var moving = false;
      $('qGrade').addEventListener('click', function (ev) {
        var btn = ev.target.closest('[data-r]');
        if (!btn || !revealed || moving) return;
        moving = true;

        var r = btn.dataset.r;
        grade(queue[pos], r);
        doneToday.push(queue[pos]);
        pos++;
        paintBottom();

        // 버튼 자리에 피드백을 잠깐 보여준 뒤 다음 문제로.
        $('qGrade').hidden = true;
        $('qFeedback').textContent = FEEDBACK[r] || '';
        $('qFeedback').className = 'q-feedback ' + r;
        $('qFeedback').hidden = false;

        setTimeout(function () {
          $('qFeedback').hidden = true;
          moving = false;
          render();
        }, 1100);
      });

      function grade(id, r) {
        var e = Kkmd.getExpr(id);
        if (!e) return;

        // 같은 날 두 번 눌러도 한 번만 반영합니다.
        var today = Kkmd.today();
        if (e.lastSeen === today) return;

        var was = e.state;
        if (r === 'ok') {
          e.state = 'ok';
          e.streak = (e.streak || 0) + 1;
          e.nextDue = Kkmd.plusDays(14);
          if (was === 'lost') Kkmd.bumpCounter('reunions', 1);
        } else if (r === 'vague') {
          e.state = 'vague';
          e.streak = 0;
          e.nextDue = Kkmd.plusDays(5);
        } else {
          e.state = 'lost';
          e.streak = 0;
          e.nextDue = Kkmd.plusDays(2);
        }
        e.lastSeen = today;

        if (e.streak >= 3) {
          e.graduated = true;
          Kkmd.bumpCounter('graduated', 1);
        }
        Kkmd.setExpr(id, e);
      }

      $('restMore').addEventListener('click', build);

      $('arGo').addEventListener('click', function () {
        $('arrive').hidden = true;
        build();
      });
    })();
  </script>
</Base>
