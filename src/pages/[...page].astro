---
/**
 * 회차 목록. 12편씩 끊어서 보여줍니다.
 *   /      → 1페이지
 *   /2/    → 2페이지
 * 검색과 태그 필터는 페이지와 무관하게 전체를 대상으로 동작합니다.
 */
import type { GetStaticPaths } from 'astro';
import { getListed } from '../lib/episodes';
import Base from '../layouts/Base.astro';
import SubscribeCta from '../components/SubscribeCta.astro';
import AgainBlock from '../components/AgainBlock.astro';
import { toPlain, toKanji } from '../lib/furigana';
import { SITE, url } from '../lib/site';
import { SEASONAL, BONUS } from '../lib/taglines';
import { toRuby } from '../lib/furigana';
import '../styles/list.css';

const PER_PAGE = 12;
/** 접었을 때 보여줄 태그 개수. 넘치면 "더 보기" 로 펼칩니다. */
const TAGS_SHOWN = 6;

export const getStaticPaths = (async ({ paginate }) => {
  const episodes = (await getListed()).reverse();
  return paginate(episodes, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

/**
 * 장면 태그는 다섯 개로 고정입니다. 회차가 늘어도 칩이 늘지 않아요.
 * 소재 태그(음식·야구)는 칩에 띄우지 않고 검색으로만 찾습니다.
 */
const SCENE_TAGS = ['부탁하기', '실수 수습', '상황 설명', '리액션', '거절·미루기'];
const all = await getListed();
const used = new Set(all.map((ep) => ep.data.tags[0]).filter(Boolean));
const tags = SCENE_TAGS.filter((t) => used.has(t));

/**
 * 시즌별로 묶습니다. 현재 시즌은 펼치고, 지난 시즌은 접힌 헤더 한 줄로.
 * 시즌이 하나뿐이면 헤더 없이 그냥 목록만 나옵니다.
 * (추억 보관함과 같은 그룹핑 방식이에요)
 */
const bySeason = new Map<number, typeof page.data>();
for (const ep of page.data) {
  const list = bySeason.get(ep.data.season) ?? [];
  list.push(ep);
  bySeason.set(ep.data.season, list);
}
const seasons = [...bySeason.entries()].sort((a, b) => b[0] - a[0]);
const currentSeason = seasons.length > 0 ? seasons[0][0] : 1;

/** 시즌 이름. 나중에 시즌마다 부제를 붙이고 싶으면 여기만 고치면 됩니다. */
const SEASON_NAME: Record<number, string> = { 1: '친구랑, 반말로' };

const fmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
const isFirst = page.currentPage === 1;

/**
 * 후리가나를 미리 ruby HTML 로 바꿔서 넘깁니다.
 * 브라우저에서는 계절·시간만 보고 고르면 되도록요.
 */
const rubyize = (lines: { jp: string; ko: string }[]) =>
  lines.map((l) => ({ jp: toRuby(l.jp), ko: l.ko }));

const TAGLINES = {
  seasonal: Object.fromEntries(
    Object.entries(SEASONAL).map(([season, slots]) => [
      season,
      Object.fromEntries(Object.entries(slots).map(([slot, lines]) => [slot, rubyize(lines)])),
    ])
  ),
  bonus: BONUS.map((b) => ({ id: b.id, lines: rubyize(b.lines) })),
};
---
<Base
  title={isFirst ? `${SITE.name} — ${SITE.tagline}` : `${SITE.name} — ${page.currentPage}페이지`}
  nav="home"
>
  <div class="wrap">
    {isFirst && (
      <div class="home-hero">
        <div class="hero-eyebrow">까먹당 · 일본어</div>
        <h1 id="tagline">{SITE.tagline}</h1>
        <p id="taglineKo">{SITE.description}</p>
      </div>
    )}

    <div class="search-box">
      <div class="search-field">
        <input
          type="search"
          id="q"
          placeholder="我慢, てもいい, 배달, 부탁하기"
          autocomplete="off"
          aria-label="회차 검색"
        />
      </div>
      <div id="search-status" class="search-status"></div>
      <div id="results" class="results"></div>
    </div>

    {isFirst && (
      <>
        <SubscribeCta
          title="배우고, 까먹고, 다시 만나는 일본어"
          lead="매주 딱 3개만 배우세요.<br />까먹으면 다시 찾아드릴게요."
          closable
        />
        <AgainBlock />
      </>
    )}

    <h2 class="home-sec" id="episodes">에피소드</h2>


    {tags.length > 0 && (
      <div class="tag-row" id="tagRow">
        <button class="tag-chip on" data-tag="">전체</button>
        {tags.map((t, i) => (
          <button class={i < TAGS_SHOWN ? 'tag-chip' : 'tag-chip extra'} data-tag={t}>{t}</button>
        ))}
        {tags.length > TAGS_SHOWN && (
          <button class="tag-chip more" id="tagMore" type="button">
            {`+${tags.length - TAGS_SHOWN}`}
          </button>
        )}
      </div>
    )}

    <div class="ep-list" id="epList">
      {seasons.map(([season, list]) => {
        const cards = list.map((ep) => (
        <a class="ep-card" href={url(`/ep/${ep.id}/`)} data-tags={ep.data.tags.join(',')}>
          <div class="ep-body">
            <div class="ep-meta">
              <span class="ep-no">{`#${String(ep.data.no).padStart(3, '0')}`}</span>
              <span class="ep-date">{fmt.format(ep.data.date)}</span>
              {ep.data.tags[0] && <span class="ep-tag">{ep.data.tags[0]}</span>}
            </div>
            <div class="ep-title" set:html={toPlain(ep.data.title)} />
            <div class="ep-sub">{ep.data.subtitle}</div>
            {/* 핵심 표현 3개 — "그 표현 어디서 봤더라" 로 찾아오는 길 */}
            {ep.data.keyPoints.length > 0 && (
              <div class="ep-keys jp">
                {ep.data.keyPoints.map((k) => toKanji(k.jp)).join(' · ')}
              </div>
            )}
          </div>
          <span class="ep-emoji" aria-hidden="true">{ep.data.emoji}</span>
        </a>
      ));

        // 시즌이 하나뿐이면 헤더 없이 목록만
        if (seasons.length === 1) return cards;

        // 현재 시즌은 펼치고, 지난 시즌은 접습니다
        return (
          <details class="season" open={season === currentSeason}>
            <summary>
              <span class="season-title">
                {`시즌 ${season}`}
                {SEASON_NAME[season] && ` · ${SEASON_NAME[season]}`}
              </span>
              <span class="season-count">{`${list.length}편`}</span>
            </summary>
            <div class="season-body">{cards}</div>
          </details>
        );
      })}
    </div>

    {page.data.length === 0 && (
      <p class="empty">아직 발행한 회차가 없어요. src/data/episodes/ 에 YAML 을 추가해 보세요.</p>
    )}

    {page.lastPage > 1 && (
      <div class="pager" id="pager">
        {page.url.prev
          ? <a class="pill" href={page.url.prev}>← 최신</a>
          : <span class="pill ghost">← 최신</span>}
        <span class="pager-count">{`${page.currentPage} / ${page.lastPage}`}</span>
        {page.url.next
          ? <a class="pill" href={page.url.next}>이전 →</a>
          : <span class="pill ghost">이전 →</span>}
      </div>
    )}

  </div>

  <script is:inline define:vars={{ INDEX: url('/search.json'), TAGLINES }}>
    window.__INDEX__ = INDEX;

    /* ---------- 계절 × 시간대 인사 ----------
       정적 사이트라 빌드 시각이 아니라 방문 시각을 기준으로 고릅니다.
       문구를 늘리거나 고치려면 src/lib/taglines.ts 만 손보면 돼요.        */
    (function () {
      var el = document.getElementById('tagline');
      var ko = document.getElementById('taglineKo');
      if (!el) return;

      var now = new Date();
      var h = now.getHours();
      var m = now.getMonth() + 1;   // 1~12
      var d = now.getDate();
      var w = now.getDay();         // 0=일 … 5=금

    /* 체감 계절. 달력보다 늦게 시작해서 늦게 끝납니다.
      봄   3/15 ~ 5/25
      여름 5/26 ~ 9/20    ← 요즘은 5월 하순부터 덥습니다
      가을 9/21 ~ 11/15
      겨울 나머지 전부 (11/16 ~ 3/14, 연말·연초에 걸쳐 있어 나머지로 둡니다) */
     
      var md = m * 100 + d;
      var special =
        (m === 1 && d === 1)       ? 'newyear' :
        (md >= 401 && md <= 415)   ? 'sakura' :
        (md >= 620 && md <= 720)   ? 'jangma' :
        (md >= 801 && md <= 820)   ? 'heat' :
        (md >= 1020 && md <= 1110) ? 'danpung' :
        (md >= 1201 && md <= 1220) ? 'firstSnow' :
        (h >= 2 && h < 5)          ? 'lateNight' :
        (w === 5 && h >= 17)       ? 'fridayNight' :
        (w === 1 && h < 12)        ? 'monday' : null;

      var season =
        (md >= 315 && md <= 525)  ? 'spring' :
        (md >= 526 && md <= 831)  ? 'summer' :
        (md >= 901 && md <= 1115) ? 'autumn' : 'winter';

      var slot =
        h >= 5  && h < 12 ? 'morning' :
        h >= 12 && h < 17 ? 'day' :
        h >= 17 && h < 21 ? 'evening' : 'night';

      var pool = null;
      if (special) {
        var hit = TAGLINES.bonus.filter(function (b) { return b.id === special; })[0];
        if (hit) pool = hit.lines;
      }
      if (!pool || !pool.length) pool = TAGLINES.seasonal[season][slot];
      if (!pool || !pool.length) return;

      // 칸에 여러 개가 있으면 그중 하나를 무작위로.
      var line = pool[Math.floor(Math.random() * pool.length)];
      el.innerHTML = line.jp;
      el.classList.add('tagline-jp');
      if (ko) ko.textContent = line.ko;
    })();
  </script>

  <script is:inline>
    /* ---------- 태그 더 보기 ---------- */
    (function () {
      var more = document.getElementById('tagMore');
      if (!more) return;
      more.addEventListener('click', function () {
        document.querySelectorAll('.tag-chip.extra').forEach(function (c) {
          c.classList.remove('extra');
        });
        more.remove();
      });
    })();

    /* ---------- 태그 필터 ---------- */
    document.querySelectorAll('.tag-chip[data-tag]').forEach(function (chip) {
      chip.addEventListener('click', function () {
        var tag = chip.dataset.tag;
        document.querySelectorAll('.tag-chip[data-tag]').forEach(function (c) {
          c.classList.toggle('on', c === chip);
        });
        document.querySelectorAll('.ep-card').forEach(function (card) {
          var tags = (card.dataset.tags || '').split(',');
          card.style.display = !tag || tags.indexOf(tag) >= 0 ? '' : 'none';
        });
      });
    });

    /* ---------- 검색 ----------
       빌드할 때 만들어둔 /search.json 을 받아 브라우저에서 부분 일치로 찾습니다.
       한자·가나·한국어 뜻 어느 쪽으로 쳐도 걸리고,
       결과에는 언제나 한자 원문을 보여줍니다.                              */
    (function () {
      var input = document.getElementById('q');
      var results = document.getElementById('results');
      var status = document.getElementById('search-status');
      var list = document.getElementById('epList');
      var tagRow = document.getElementById('tagRow');
      var pager = document.getElementById('pager');
      var docs = null;
      var timer = null;

      function norm(s) {
        return s.replace(/[\s、。，．！？!?「」『』()（）·・…~〜\-]/g, '').toLowerCase();
      }

      function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      /* 검색어와 겹치는 부분에 표시를 답니다.
         ------------------------------------------------------------
         덩어리 목록(p)을 받아 두 갈래로 대조합니다.
           · 보이는 글자   配達じゃなくて…   → 한자로 친 검색어가 걸림
           · 읽는 법       はいたつじゃなくて… → 가나로 친 검색어가 걸림

         어느 쪽에서 걸리든 "그 덩어리" 를 통째로 칠하므로,
         はいたつ 로 찾아도 화면에는 配達 만 표시됩니다.
         가나를 따로 띄울 필요가 없어요.                                  */
      var STRIP = /[\s、。，．！？!?「」『』()（）·・…~〜\-]/;

      /** 덩어리 목록 → 표준형 문자열 + 각 글자가 몇 번째 덩어리였는지 */
      function flatten(parts, useReading) {
        var chars = [], owner = [];
        for (var i = 0; i < parts.length; i++) {
          var text = useReading ? (parts[i][1] || parts[i][0]) : parts[i][0];
          for (var j = 0; j < text.length; j++) {
            if (STRIP.test(text[j])) continue;
            chars.push(text[j].toLowerCase());
            owner.push(i);
          }
        }
        return { flat: chars.join(''), owner: owner };
      }

      /* 읽는 법까지 대조할지 판단합니다.
         한 글자 검색에서 읽기까지 뒤지면 노이즈가 큽니다.
         예) も 로 찾으면 注文(ちゅうもん), 思う(おもう) 처럼
             읽기 안쪽에만 들어 있는 한자까지 전부 걸려요.
         그래서 두 글자 이상일 때만 읽기를 봅니다.                          */
      function useReadings(q) { return q.length >= 2; }

      /** 검색어가 걸린 덩어리 번호를 모읍니다 */
      function hitParts(parts, q) {
        var marked = {};
        var modes = useReadings(q) ? [false, true] : [false];
        modes.forEach(function (useReading) {
          var f = flatten(parts, useReading);
          var at = f.flat.indexOf(q);
          while (at >= 0) {
            for (var k = at; k < at + q.length; k++) marked[f.owner[k]] = true;
            at = f.flat.indexOf(q, at + q.length);
          }
        });
        return marked;
      }

      /** 덩어리 목록을 화면용 HTML 로. 걸린 덩어리에 표시를 답니다. */
      function markParts(parts, q) {
        if (!parts) return '';
        var marked = q ? hitParts(parts, q) : {};
        var out = '', open = false;
        for (var i = 0; i < parts.length; i++) {
          var on = !!marked[i];
          if (on && !open) { out += '<mark>'; open = true; }
          if (!on && open) { out += '</mark>'; open = false; }
          out += esc(parts[i][0]);
        }
        return out + (open ? '</mark>' : '');
      }

      /** 한국어 뜻처럼 읽는 법이 없는 문자열용 */
      function markText(original, q) {
        if (!q || !original) return esc(original || '');
        return markParts(original.split('').map(function (c) { return [c]; }), q);
      }

      async function load() {
        if (docs) return docs;
        try {
          var res = await fetch(window.__INDEX__);
          docs = await res.json();
          return docs;
        } catch (e) {
          status.textContent = '검색 자료를 불러오지 못했어요.';
          return null;
        }
      }

      function showList(on) {
        var sec = document.getElementById('episodes');
        if (sec) sec.style.display = on ? '' : 'none'; 
        list.style.display = on ? '' : 'none';
        if (tagRow) tagRow.style.display = on ? '' : 'none';
        if (pager) pager.style.display = on ? '' : 'none';
        results.style.display = on ? 'none' : 'block';
      }

      input.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(run, 140);
      });

      async function run() {
        var raw = input.value.trim();
        if (!raw) { showList(true); status.textContent = ''; results.innerHTML = ''; return; }

        var data = await load();
        if (!data) return;

        var q = norm(raw);
        if (!q) { showList(true); return; }

        showList(false);

        var found = [];
        var deep = useReadings(q);

        /** 이 항목이 검색어에 걸리는지. 짧은 검색어는 보이는 글자만 봅니다. */
        function matches(parts, extra, wide) {
          if (wide) return wide.indexOf(q) >= 0;
          return flatten(parts, false).flat.indexOf(q) >= 0 ||
                 (extra ? norm(extra).indexOf(q) >= 0 : false);
        }

        data.forEach(function (doc) {
          var hits = doc.entries.filter(function (e) {
            return matches(e.p, e.mean, deep ? e.q : null);
          });
          var titleHit = matches(doc.p, doc.subtitle + doc.tags.join(''), deep ? doc.q : null);
          if (!hits.length && !titleHit) return;

          // 짧은 항목이 위로 오게 — 단어가 문장보다 먼저 보이는 편이 읽기 좋아요.
          hits.sort(function (a, b) { return a.p.length - b.p.length; });
          found.push({ doc: doc, hits: hits, score: (titleHit ? 100 : 0) + hits.length });
        });

        found.sort(function (a, b) { return b.score - a.score || b.doc.no - a.doc.no; });

        status.textContent = found.length
          ? found.length + '개 회차에서 찾았어요'
          : '결과가 없어요. 다른 말로 찾아보세요.';

        results.innerHTML = found.slice(0, 12).map(function (f) {
          var rows = f.hits.slice(0, 4).map(function (e) {
            return '<div class="hit" data-kind="' + esc(e.kind) + '">' +
                   '<span class="hit-kind">' + esc(e.kind) + '</span>' +
                   '<div class="hit-body">' +
                      '<span class="hit-jp">' + markParts(e.p, q) + '</span>' +
                      '<span class="hit-mean">' + markText(e.mean, q) + '</span>' +
                    '</div>' +
                  '</div>';
          }).join('');
          var more = f.hits.length > 4
            ? '<div class="hit-more">외 ' + (f.hits.length - 4) + '개</div>' : '';

          return '<a class="result" href="' + f.doc.url + '">' +
                 '<div class="result-meta">#' +
                   String(f.doc.no).padStart(3, '0') + ' · ' + markText(f.doc.subtitle, q) + '</div>' +
                 '<div class="result-title">' + markParts(f.doc.p, q) + '</div>' +
                 rows + more + '</a>';
        }).join('');
      }
    })();
  </script>
</Base>
