---
import Rich from './Rich.astro';
import type { Question } from '../lib/content/more-content';
interface Props { question: Question }
const { question } = Astro.props;
---
<section class="episode-question">
  <Rich tag="h4" class="compare-title" text={question.title} />
  {question.kind === 'compare' ? <>
    {question.intro && <Rich tag="p" text={question.intro} />}
    <dl class="episode-comparison">{question.items.map((item) => <div><dt lang="ja"><Rich tag="span" text={item.term} /></dt><dd><Rich text={item.description} /></dd></div>)}</dl>
    {question.note && <Rich tag="p" class="comparison-conclusion" text={question.note} />}
  </> : <Rich tag="p" class="tip" text={question.answer} />}
</section>
