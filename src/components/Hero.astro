---
import Jp from './Jp.astro';
interface Props { emoji: string; title: string; subtitle: string; }
const { emoji, title, subtitle } = Astro.props;
---
<div class="hero">
  <span class="hero-emoji">{emoji}</span>
  <div class="hero-eyebrow">까먹당 · 에피소드</div>
  <h1><Jp text={title} /></h1>
  <p>{subtitle}</p>
</div>
