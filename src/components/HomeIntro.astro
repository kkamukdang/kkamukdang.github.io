---
import { url } from '../lib/site';
import { heroPreviewScenes } from '../lib/ui/hero-scenes';
const samples = heroPreviewScenes();
---
<section class="home-intro" aria-labelledby="home-intro-title" data-home-hero data-hero-state="intro" data-hero-pending="true" data-catalog-url={url('/expressions.json')} data-again-url={url('/again/')}>
  <p class="home-intro-kicker"><img src={url('/ui/hero-bird.webp')} width="40" height="28" alt="" />배우고, 까먹고, 다시 만나는 일본어</p>
  <div class="home-intro-stage">
    <div class={`home-hero-scenes count-${samples.length}`} data-hero-scenes data-count={samples.length}>
      {samples.map(scene => <p class="home-example"><span class="hero-scene-icon" aria-hidden="true">{scene.icon}</span><span class="hero-scene-text">{scene.text}</span></p>)}
    </div>
    <h1 id="home-intro-title">이런 표현을<br />만날 수 있어요!</h1>
    <img class="home-intro-underline" src={url('/ui/hero-underline.webp')} width="279" height="22" alt="" />
    <a class="home-browse" href="#episodes">에피소드 둘러보기 ↓</a>
  </div>
  <img class="home-decoration home-star" src={url('/ui/hero-star.webp')} width="607" height="655" alt="" />
  <img class="home-decoration home-letter" src={url('/ui/hero-letter.webp')} width="566" height="593" alt="" />
</section>

<script>
  import { initHomeHero } from '../lib/client/home-hero';
  // Main-only opt-in: native #episodes URL/history/focus semantics stay intact.
  if (document.body.classList.contains('home-redesign')) document.documentElement.dataset.homeScroll = 'true';
  initHomeHero();
</script>
