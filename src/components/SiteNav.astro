---
/**
 * 상단 고정 내비게이션 — 2칸.
 * 할 일은 둘뿐입니다. 새로 읽거나, 다시 만나거나.
 *
 * 단어 카드와 한자 쓰기는 메뉴에서 내렸어요.
 *   단어 카드 → 「다시 만나기」 하단에서 들어갑니다
 *   한자 쓰기 → 에피소드의 「더 파보기」 안에서
 */
import { getListed } from '../lib/episodes';
import { SITE, url } from '../lib/site';
import Logo from './Logo.astro';

interface Props { current?: 'episode' | 'again' }
const { current } = Astro.props;

/**
 * 「에피소드」는 목록이 아니라 **최신 회차 본문**으로 갑니다.
 * 이 서비스에서 에피소드의 기본 행동은 훑기가 아니라 읽기예요.
 * 매주 새 편이 나오면 자동으로 그쪽을 가리켜 "이번 주 편 보기" 처럼 동작합니다.
 *
 * "안 읽은 최신 편" 으로 보내지 않습니다. 기록이 없는 기기에서는 1편으로 끌려가고,
 * 같은 메뉴가 사람마다 다른 곳으로 가면 예측이 어려워져요.
 *
 * 목록으로 가는 길은 홈과, 에피소드 상세의 「전체 에피소드」 버튼 두 곳입니다.
 */
const episodes = await getListed();
const latest = episodes[episodes.length - 1];

const links = [
  {
    key: 'episode',
    href: latest ? url(`/ep/${latest.id}/`) : url('/'),
    label: '에피소드',
  },
  { key: 'again', href: url('/again/'), label: '다시 만나기' },
] as const;
---
<nav class="site-nav">
  <div class="nav-inner">
    <a class="nav-brand" href={url('/')}>
      <Logo height={32} />
    </a>

    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href} class={current === l.key ? 'nav-link on' : 'nav-link'}>
          {l.label}
        </a>
      ))}
    </div>

    <button class="theme-toggle" id="themeToggle" type="button" aria-label="화면 테마 바꾸기">
      <span class="t-ico" id="themeIcon">☀</span>
    </button>
  </div>
</nav>
